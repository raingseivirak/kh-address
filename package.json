{
  "name": "kh-address",
  "version": "2.1.0",
  "description": "Practical Cambodian address library with bilingual (English/Khmer) support, autocomplete UI, postal codes, and lazy-loaded village data",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./villages": {
      "import": {
        "types": "./dist/villages.d.ts",
        "default": "./dist/villages.js"
      },
      "require": {
        "types": "./dist/villages.d.cts",
        "default": "./dist/villages.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./web-component": {
      "import": {
        "types": "./dist/web-component.d.ts",
        "default": "./dist/web-component.js"
      },
      "require": {
        "types": "./dist/web-component.d.cts",
        "default": "./dist/web-component.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:data": "node scripts/build-data.cjs && node scripts/split-villages.cjs && node scripts/build-postal.cjs",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cambodia",
    "khmer",
    "address",
    "provinces",
    "districts",
    "communes",
    "villages",
    "postal-code",
    "autocomplete",
    "cambodian-address",
    "khmer-address",
    "geodata",
    "typescript",
    "react",
    "web-component"
  ],
  "author": "Raingsei Virak",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "pumi": "^1.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "yaml": "^2.9.0"
  }
}
